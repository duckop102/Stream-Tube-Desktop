import { AboutSlint, ListView, ScrollView, Palette, Spinner } from "std-widgets.slint";

export enum Screen { home, shorts, following, library, search, settings, channel, playlist, language, you }

export global UiText {
    in property <string> language;
    pure callback lookup(string, string) -> string;

    pure public function tr(source: string) -> string {
        return root.lookup(root.language, source);
    }
}

// Colours of the YouTube-style dark theme.
global Theme {
    out property <color> background: #0f0f0f;
    out property <color> surface: #272727;
    out property <color> raised: #212121;
    out property <color> pressed: #3f3f3f;
    out property <color> text: #f1f1f1;
    out property <color> secondary: #aaaaaa;
    out property <color> divider: #ffffff1a;
    out property <color> accent: #ff4e6a;
}

export struct LanguageRow {
    code: string,
    name: string,
    credit: string,
}

export struct ChannelRow {
    id: string,
    name: string,
    initial: string,
    avatar-url: string,
    avatar: image,
    has-avatar: bool,
}

export struct VideoRow {
    id: string,
    title: string,
    channel: string,
    channel-id: string,
    duration: string,
    views: string,
    published: string,
    saved: bool,
    short: bool,
    thumbnail: image,
    has-thumbnail: bool,
    // 0 a video card, 1 the Shorts shelf
    kind: int,
    initial: string,
    avatar-url: string,
    avatar: image,
    has-avatar: bool,
}

enum Glyph { none, home, shorts, following, you, settings, back, search, more, clock, fill, close, bookmark, block, channel, refresh, gear, comment, dots, play }

component Symbol inherits Path {
    in property <Glyph> glyph;
    in property <color> tint;
    in property <bool> filled;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.tint;
    stroke-width: 1.8px;
    fill: root.filled ? root.tint : transparent;
    fill-rule: evenodd;
    commands: root.glyph == Glyph.home ? "M 4.5 9.8 L 12 3.8 L 19.5 9.8 L 19.5 20.2 L 14.2 20.2 L 14.2 14.2 L 9.8 14.2 L 9.8 20.2 L 4.5 20.2 Z"
        : root.glyph == Glyph.shorts ? "M 8.5 3 L 15.5 3 L 18 6 L 18 18 L 15.5 21 L 8.5 21 L 6 18 L 6 6 Z M 10.5 9 L 14.5 12 L 10.5 15 Z"
        : root.glyph == Glyph.following ? "M 4 8.5 L 20 8.5 L 20 20 L 4 20 Z M 6 5.5 L 18 5.5 M 8 2.8 L 16 2.8 M 10.5 11.5 L 14.5 14.2 L 10.5 17 Z"
        : root.glyph == Glyph.you ? "M 12 4 A 3.6 3.6 0 1 1 11.99 4 Z M 5 20 C 5 15.6 8 13.6 12 13.6 C 16 13.6 19 15.6 19 20 Z"
        : root.glyph == Glyph.settings ? "M 4 7 L 20 7 M 4 12 L 20 12 M 4 17 L 20 17 M 9 4.5 L 9 9.5 M 15 9.5 L 15 14.5 M 10 14.5 L 10 19.5"
        : root.glyph == Glyph.back ? "M 20 12 L 4.5 12 M 11 5.5 L 4.5 12 L 11 18.5"
        : root.glyph == Glyph.search ? "M 10.5 3.8 A 6.7 6.7 0 1 1 10.49 3.8 Z M 15.5 15.5 L 20.5 20.5"
        : root.glyph == Glyph.more ? "M 12 4.2 A 1.5 1.5 0 1 1 11.99 4.2 Z M 12 10.5 A 1.5 1.5 0 1 1 11.99 10.5 Z M 12 16.8 A 1.5 1.5 0 1 1 11.99 16.8 Z"
        : root.glyph == Glyph.clock ? "M 12 3.5 A 8.5 8.5 0 1 1 11.99 3.5 Z M 12 7.5 L 12 12 L 15.2 14"
        : root.glyph == Glyph.fill ? "M 7 7 L 17.5 17.5 M 7 7 L 7 14.5 M 7 7 L 14.5 7"
        : root.glyph == Glyph.close ? "M 6 6 L 18 18 M 18 6 L 6 18"
        : root.glyph == Glyph.bookmark ? "M 7 3.8 L 17 3.8 L 17 20.2 L 12 16.6 L 7 20.2 Z"
        : root.glyph == Glyph.block ? "M 12 3.5 A 8.5 8.5 0 1 1 11.99 3.5 Z M 6 6 L 18 18"
        : root.glyph == Glyph.channel ? "M 3.5 5 L 20.5 5 L 20.5 19 L 3.5 19 Z M 12 8 A 2.4 2.4 0 1 1 11.99 8 Z M 7.5 16.5 C 8 14.2 9.8 13.3 12 13.3 C 14.2 13.3 16 14.2 16.5 16.5"
        : root.glyph == Glyph.gear ? "M 12 8.6 A 3.4 3.4 0 1 1 11.99 8.6 Z M 10.6 2.8 L 13.4 2.8 L 13.9 5.3 L 15.6 6.3 L 18 5.4 L 19.4 7.8 L 17.5 9.5 L 17.5 14.5 L 19.4 16.2 L 18 18.6 L 15.6 17.7 L 13.9 18.7 L 13.4 21.2 L 10.6 21.2 L 10.1 18.7 L 8.4 17.7 L 6 18.6 L 4.6 16.2 L 6.5 14.5 L 6.5 9.5 L 4.6 7.8 L 6 5.4 L 8.4 6.3 L 10.1 5.3 Z"
        : root.glyph == Glyph.refresh ? "M 19 12 A 7 7 0 1 1 16.6 6.7 M 19 4 L 19 8.5 L 14.5 8.5"
        : root.glyph == Glyph.comment ? "M 4 4.8 L 20 4.8 L 20 16.2 L 10 16.2 L 6 19.8 L 6 16.2 L 4 16.2 Z M 8 9 L 16 9 M 8 12.2 L 13.5 12.2"
        : root.glyph == Glyph.dots ? "M 5 10.4 A 1.6 1.6 0 1 1 4.99 10.4 Z M 12 10.4 A 1.6 1.6 0 1 1 11.99 10.4 Z M 19 10.4 A 1.6 1.6 0 1 1 18.99 10.4 Z"
        : root.glyph == Glyph.play ? "M 7.5 4.8 L 18.5 12 L 7.5 19.2 Z" : "";
}

// A round icon button with a soft press highlight.
component IconButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> description;
    in property <color> tint: Theme.text;
    in property <bool> filled;
    in property <length> icon-size: 24px;
    in property <length> stroke-width: 1.8px;
    callback pressed;
    width: 40px;
    height: 40px;
    border-radius: self.height / 2;
    background: touch.pressed ? #ffffff26 : #ffffff00;
    animate background { duration: 140ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.description;
    Symbol {
        width: root.icon-size;
        height: root.icon-size;
        glyph: root.glyph;
        tint: root.tint;
        filled: root.filled;
        stroke-width: root.stroke-width;
    }
    touch := TouchArea { clicked => { root.pressed(); } }
}

// Generic pill button: white when primary (like Subscribe), grey otherwise.
component Pill inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> active: true;
    callback pressed;
    height: 36px;
    min-width: 64px;
    border-radius: self.height / 2;
    background: !root.active ? #1f1f1f
        : root.primary ? (touch.pressed ? #d9d9d9 : Theme.text)
        : (touch.pressed ? Theme.pressed : Theme.surface);
    animate background { duration: 140ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.label;
            color: !root.active ? #717171 : root.primary ? #0f0f0f : Theme.text;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        enabled: root.active;
        clicked => { root.pressed(); }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback pressed;
    height: 32px;
    border-radius: 8px;
    background: root.selected ? Theme.text : (touch.pressed ? Theme.pressed : Theme.surface);
    animate background { duration: 180ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.label;
            color: root.selected ? #0f0f0f : Theme.text;
            animate color { duration: 180ms; easing: ease-out; }
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.pressed(); } }
}

// A text tab of the Home screen; the selected one sits in a dark pill.
component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback pressed;
    height: 36px;
    border-radius: self.height / 2;
    background: root.selected ? #ffffff1f : (touch.pressed ? #ffffff12 : #ffffff00);
    border-width: root.selected ? 1px : 0px;
    border-color: #ffffff10;
    animate background { duration: 160ms; easing: ease-out; }
    accessible-role: tab;
    accessible-label: root.label;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 16px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.pressed(); } }
}

// Hides the corner of a picture outside a quarter circle, for pictures that
// round only some corners.
component Corner inherits Path {
    // false: bottom left, true: bottom right
    in property <bool> right;
    width: 18px;
    height: 18px;
    viewbox-width: 18;
    viewbox-height: 18;
    fill: Theme.background;
    commands: root.right ? "M 18 0 L 18 18 L 0 18 A 18 18 0 0 0 18 0 Z" : "M 0 0 L 0 18 L 18 18 A 18 18 0 0 1 0 0 Z";
}

// Circle with the channel picture, or its initial while the picture loads.
component Avatar inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <string> initial;
    width: 36px;
    height: self.width;
    border-radius: self.width / 2;
    clip: true;
    background: #5a3a8c;
    if !root.has-image: Text {
        text: root.initial;
        color: #ffffff;
        font-size: root.width * 0.44;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.has-image: Image {
        width: root.width;
        height: root.height;
        source: root.source;
        image-fit: cover;
    }
}

// Stream Tube's own mark: a red play tile and the wordmark.
component Logo inherits HorizontalLayout {
    spacing: 5px;
    alignment: start;
    Rectangle {
        width: 29px;
        height: 20px;
        y: (parent.height - self.height) / 2;
        border-radius: 5px;
        background: #ff0033;
        Path {
            width: 9px;
            height: 10px;
            viewbox-width: 9;
            viewbox-height: 10;
            fill: #ffffff;
            commands: "M 0 0 L 9 5 L 0 10 Z";
        }
    }
    Text {
        text: "StreamTube";
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -1px;
        vertical-alignment: center;
    }
}

// A bottom-bar tab: an icon only, as on the YouTube phone app.
component NavigationItem inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> label;
    in property <bool> selected;
    // the You tab shows the account picture once signed in
    in property <bool> account;
    in property <image> photo;
    in property <bool> has-photo;
    in property <string> initial;
    callback pressed;

    horizontal-stretch: 1;
    accessible-role: tab;
    accessible-label: label;
    Rectangle {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: touch.pressed ? #ffffff1f : #ffffff00;
        animate background { duration: 160ms; easing: ease-out; }
    }
    if !root.account: Symbol {
        width: 27px;
        height: 27px;
        glyph: root.glyph;
        tint: Theme.text;
        filled: root.selected;
        stroke-width: 1.7px;
    }
    if root.account: Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 14px;
        border-width: root.selected ? 1.5px : 0px;
        border-color: Theme.text;
        Avatar {
            width: root.selected ? 23px : 27px;
            source: root.photo;
            has-image: root.has-photo;
            initial: root.initial;
            background: #00897b;
        }
    }
    touch := TouchArea { clicked => { root.pressed(); } }
}

component LanguageItem inherits Rectangle {
    in property <LanguageRow> entry;
    in property <bool> selected;
    callback pressed;
    height: 56px;
    background: touch.pressed ? Theme.surface : transparent;
    animate background { duration: 160ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.entry.name + (root.entry.credit == "" ? "" : ", " + root.entry.credit);

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.entry.code == "system" ? UiText.tr("System") : root.entry.name;
                color: Theme.text;
                font-size: 15px;
            }
            if root.entry.credit != "": Text {
                text: root.entry.credit;
                color: Theme.secondary;
                font-size: 12px;
            }
        }
        if root.selected: Text {
            text: "✓";
            color: Theme.text;
            font-size: 19px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.pressed(); } }
}

// A video in a feed as the YouTube phone app shows it: the picture edge to edge,
// then a dark panel with the title, the channel and the actions.
component VideoCard inherits Rectangle {
    in property <VideoRow> video;
    in property <length> radius: 18px;
    callback watch;
    callback menu;
    callback save;
    callback open-channel;
    property <length> frame-height: self.width * 9 / 16;
    height: frame-height + panel.height;

    preview := Rectangle {
        y: 0;
        height: root.frame-height;
        background: Theme.surface;
        accessible-role: button;
        accessible-label: root.video.title;

        if root.video.has-thumbnail: Image {
            width: parent.width;
            height: parent.height;
            source: root.video.thumbnail;
            image-fit: cover;
        }
        if root.video.duration != "": Rectangle {
            x: parent.width - self.width - 12px;
            y: parent.height - self.height - 12px;
            width: badge.preferred-width + 14px;
            height: 22px;
            border-radius: 11px;
            background: root.video.duration == "LIVE" ? #cc0000 : #000000a6;
            badge := Text {
                text: root.video.duration;
                color: #ffffff;
                font-size: 13px;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Rectangle {
            background: preview-touch.pressed ? #00000059 : #00000000;
            animate background { duration: 120ms; easing: ease-out; }
        }
        preview-touch := TouchArea { clicked => { root.watch(); } }
    }

    panel := Rectangle {
        y: root.frame-height;
        height: body.preferred-height;
        background: panel-touch.pressed ? #2a2a2a : Theme.raised;
        border-bottom-left-radius: root.radius;
        border-bottom-right-radius: root.radius;
        animate background { duration: 120ms; easing: ease-out; }
        panel-touch := TouchArea { clicked => { root.watch(); } }
        body := VerticalLayout {
            padding-left: 16px;
            padding-right: 8px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 12px;
            HorizontalLayout {
                padding-right: 8px;
                Text {
                    text: root.video.title;
                    // two lines at most, as on YouTube
                    height: min(self.preferred-height, 46px);
                    horizontal-alignment: left;
                    vertical-alignment: top;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 500;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    y: (parent.height - self.height) / 2;
                    Avatar {
                        source: root.video.avatar;
                        has-image: root.video.has-avatar;
                        initial: root.video.initial;
                    }
                    TouchArea {
                        enabled: root.video.channel-id != "";
                        clicked => { root.open-channel(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.video.channel;
                        color: Theme.secondary;
                        font-size: 14px;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        if root.video.views != "": Symbol {
                            width: 13px;
                            height: 13px;
                            y: (parent.height - self.height) / 2;
                            glyph: Glyph.play;
                            tint: Theme.secondary;
                            stroke-width: 1.6px;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.video.views
                                + (root.video.views != "" && root.video.published != "" ? "   " : "") + root.video.published;
                            color: Theme.secondary;
                            font-size: 14px;
                            overflow: elide;
                        }
                    }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Glyph.comment;
                    stroke-width: 1.6px;
                    description: UiText.tr("Comments");
                    pressed => { root.watch(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Glyph.bookmark;
                    filled: root.video.saved;
                    stroke-width: 1.6px;
                    description: root.video.saved ? UiText.tr("Remove from Watch later") : UiText.tr("Save to Watch later");
                    pressed => { root.save(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    glyph: Glyph.dots;
                    filled: true;
                    description: UiText.tr("More actions");
                    pressed => { root.menu(); }
                }
            }
        }
    }
}

component ShortCard inherits Rectangle {
    in property <VideoRow> video;
    // the picture's outer bottom corner is rounded: 0 none, 1 left, 2 right
    in property <int> corner;
    callback watch;
    background: Theme.surface;
    accessible-role: button;
    accessible-label: root.video.title;
    if root.video.has-thumbnail: Image {
        width: parent.width;
        height: parent.height;
        source: root.video.thumbnail;
        image-fit: cover;
    }
    Rectangle {
        y: parent.height - self.height;
        height: 96px;
        background: @linear-gradient(180deg, #00000000 0%, #000000b3 100%);
    }
    Text {
        x: 12px;
        y: parent.height - self.height - 12px;
        width: parent.width - 24px;
        height: min(self.preferred-height, 42px);
        text: root.video.title;
        color: #ffffff;
        font-size: 15px;
        font-weight: 500;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: bottom;
    }
    Rectangle {
        background: touch.pressed ? #00000059 : #00000000;
        animate background { duration: 120ms; easing: ease-out; }
    }
    if root.corner == 1: Corner { x: 0; y: parent.height - self.height; }
    if root.corner == 2: Corner { x: parent.width - self.width; y: parent.height - self.height; right: true; }
    touch := TouchArea { clicked => { root.watch(); } }
}

// The Shorts card of Home: a title row and four Shorts in a 2 x 2 grid.
global ShortsMetrics {
    public pure function tile-height(shelf: length) -> length {
        return (shelf - 4px) / 2 * 16 / 9;
    }
    public pure function shelf-height(shelf: length) -> length {
        return 60px + self.tile-height(shelf) * 2 + 4px;
    }
}

component ShortsShelf inherits Rectangle {
    in property <[VideoRow]> shorts;
    callback watch(string);
    property <length> tile-width: (self.width - 4px) / 2;
    property <length> tile-height: ShortsMetrics.tile-height(self.width);
    height: ShortsMetrics.shelf-height(self.width);
    Rectangle {
        y: 0;
        height: 60px;
        background: Theme.raised;
        border-top-left-radius: 18px;
        border-top-right-radius: 18px;
        Text {
            x: 16px;
            text: UiText.tr("Shorts");
            color: Theme.text;
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    for short[index] in root.shorts: ShortCard {
        visible: index < 4;
        x: Math.mod(index, 2) * (root.tile-width + 4px);
        y: 60px + Math.floor(index / 2) * (root.tile-height + 4px);
        width: root.tile-width;
        height: root.tile-height;
        corner: index == 2 ? 1 : index == 3 ? 2 : 0;
        video: short;
        watch => { root.watch(short.id); }
    }
}

// Placeholder card that pulses while a feed loads.
component SkeletonCard inherits Rectangle {
    property <float> glow: 0.55 + 0.25 * Math.sin(animation-tick() / 1ms * 0.0045 * 1rad);
    property <length> frame-height: self.width * 9 / 16;
    height: frame-height + 116px;
    Rectangle {
        y: 0;
        height: root.frame-height;
        background: Theme.surface;
        opacity: root.glow;
    }
    Rectangle {
        y: root.frame-height;
        height: 116px;
        background: Theme.raised;
        border-bottom-left-radius: 18px;
        border-bottom-right-radius: 18px;
    }
    Rectangle {
        x: 16px;
        y: root.frame-height + 16px;
        width: root.width - 64px;
        height: 16px;
        border-radius: 4px;
        background: Theme.surface;
        opacity: root.glow;
    }
    Rectangle {
        x: 16px;
        y: root.frame-height + 64px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: Theme.surface;
        opacity: root.glow;
    }
    Rectangle {
        x: 64px;
        y: root.frame-height + 68px;
        width: (root.width - 100px) * 0.45;
        height: 12px;
        border-radius: 4px;
        background: Theme.surface;
        opacity: root.glow;
    }
}

// A small card for the rows on the You tab.
component MiniCard inherits Rectangle {
    in property <VideoRow> video;
    callback watch;
    width: 160px;
    height: 150px;
    VerticalLayout {
        spacing: 6px;
        Rectangle {
            height: 90px;
            border-radius: 8px;
            clip: true;
            background: Theme.surface;
            if root.video.has-thumbnail: Image {
                width: parent.width;
                height: parent.height;
                source: root.video.thumbnail;
                image-fit: cover;
            }
            if root.video.duration != "": Rectangle {
                x: parent.width - self.width - 5px;
                y: parent.height - self.height - 5px;
                width: mini-badge.preferred-width + 6px;
                height: 17px;
                border-radius: 3px;
                background: #000000cc;
                mini-badge := Text {
                    text: root.video.duration;
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                background: touch.pressed ? #00000059 : #00000000;
                animate background { duration: 120ms; easing: ease-out; }
            }
        }
        Text {
            text: root.video.title;
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
            overflow: elide;
            height: 34px;
        }
        Text {
            text: root.video.channel;
            color: Theme.secondary;
            font-size: 12px;
            overflow: elide;
        }
    }
    touch := TouchArea { clicked => { root.watch(); } }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> toggle;
    in property <bool> checked;
    in property <bool> chevron;
    callback pressed;
    height: root.detail == "" ? 52px : 64px;
    background: touch.pressed ? Theme.surface : transparent;
    animate background { duration: 140ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: 15px;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.secondary;
                font-size: 12px;
                overflow: elide;
            }
        }
        if root.toggle: Rectangle {
            width: 42px;
            // the switch mirrors the setting; the row's touch area changes it
            track := Rectangle {
                width: 36px;
                height: 20px;
                border-radius: 10px;
                background: root.checked ? #3ea6ff : #717171;
                animate background { duration: 180ms; easing: ease-out; }
                Rectangle {
                    x: root.checked ? parent.width - self.width - 2px : 2px;
                    animate x { duration: 200ms; easing: ease-out; }
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: #ffffff;
                }
            }
        }
        if root.chevron: Text {
            text: "›";
            color: Theme.secondary;
            font-size: 22px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.pressed(); } }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    padding-left: 16px;
    padding-right: 16px;
    height: 44px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: 18px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

component SignInCode inherits Rectangle {
    in property <string> code;
    callback open;
    callback cancel;

    border-radius: 12px;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.divider;
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: 220ms; easing: ease-out; }

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text {
            text: UiText.tr("Confirm this code on youtube.com/activate");
            color: Theme.secondary;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Text {
            text: root.code;
            color: Theme.text;
            font-size: 28px;
            font-weight: 800;
            letter-spacing: 3px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Pill {
                label: UiText.tr("Open youtube.com/activate");
                primary: true;
                pressed => { root.open(); }
            }
            Pill {
                label: UiText.tr("Cancel");
                pressed => { root.cancel(); }
            }
        }
    }
}

component SheetRow inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> label;
    in property <bool> filled;
    callback pressed;
    height: 52px;
    background: touch.pressed ? Theme.pressed : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 20px;
        Symbol {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            glyph: root.glyph;
            tint: Theme.text;
            filled: root.filled;
        }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 15px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea { clicked => { root.pressed(); } }
}

export component StreamTube inherits Window {
    title: "Stream Tube";
    min-width: 288px;
    min-height: 300px;
    preferred-width: 412px;
    preferred-height: 820px;
    background: Theme.background;
    default-font-size: 14px;
    init => { Palette.color-scheme = ColorScheme.dark; content-focus.focus(); }

    in property <[VideoRow]> videos;
    in property <[VideoRow]> shorts-shelf;
    in property <[VideoRow]> history-preview;
    in property <[VideoRow]> saved-preview;
    in property <[ChannelRow]> channels;
    in property <[string]> suggestions;
    in property <[string]> recent-searches;
    in property <bool> busy;
    in property <bool> has-more;
    in property <bool> personal-home;
    in property <bool> loading-more;
    in property <bool> load-more-failed;
    in property <bool> failed;
    in property <string> message;
    in property <string> notice;
    in property <[LanguageRow]> languages;
    in property <int> language-choice;
    in property <string> language-label;
    in property <bool> thumbnails;
    in property <bool> sponsorblock;
    in property <bool> dearrow-titles;
    in property <bool> dearrow-thumbnails;
    in property <bool> dislike-count;
    in property <string> channel-name;
    in property <bool> channel-followed;
    in property <bool> channel-remote;
    in property <string> channel-initial;
    in property <image> channel-avatar;
    in property <bool> channel-has-avatar;
    in property <string> channel-avatar-url;
    in property <bool> account-available;
    in property <bool> account-connected;
    in property <bool> account-busy;
    in property <string> account-name;
    in property <string> account-initial;
    in property <string> account-photo-url;
    in property <image> account-photo;
    in property <bool> account-has-photo;
    in property <string> account-message;
    in property <string> account-code;
    in property <string> app-version;
    // 0 idle, 1 checking, 2 up to date, 3 available, 4 downloading, 5 confirming, 6 failed
    in property <int> update-state;
    in property <string> update-name;
    in property <int> update-progress;
    in property <string> update-error;
    in-out property <bool> update-dismissed;
    in-out property <string> search-query;
    in-out property <bool> search-editing: true;
    in-out property <int> category: 0;
    in-out property <bool> history-mode: false;
    in-out property <bool> channels-mode: false;
    in-out property <length> feed-scroll: 0px;
    property <bool> showing-channels: screen == Screen.following && channels-mode;
    in-out property <Screen> screen: Screen.home;
    in-out property <Screen> tab: Screen.home;
    property <bool> auxiliary: screen == Screen.search || screen == Screen.settings
        || screen == Screen.channel || screen == Screen.playlist || screen == Screen.language
        || screen == Screen.library;
    property <bool> feed-screen: screen != Screen.settings && screen != Screen.language
        && screen != Screen.you && screen != Screen.shorts
        && !(screen == Screen.search && root.search-editing);
    property <length> card-width: min(self.width - root.safe-area-insets.left - root.safe-area-insets.right, 640px);
    property <bool> wide: self.width > 660px;
    // the video the ⋮ sheet is about
    property <VideoRow> menu-video;
    property <bool> menu-open;
    in-out property <bool> notice-hidden;

    callback navigate(Screen);

    function pick-category(index: int) {
        content-focus.focus();
        root.category = index;
        root.feed-scroll = 0;
        if root.screen == Screen.home {
            root.reload();
        } else {
            root.navigate(Screen.home);
        }
    }
    callback back;
    callback reload;
    callback load-more;
    callback page-appended(bool);
    callback shorts-page-ready;
    callback open-shorts;
    callback player-event(int, int, string);
    callback submit(string);
    callback query-changed(string);
    callback watch(string);
    callback watch-short(string);
    callback watch-preview(bool, string);
    callback save(string);
    callback hide-video(string);
    callback open-channel(string, string);
    callback follow;
    callback choose-language(int);
    callback toggle-thumbnails;
    // Settings → Network check
    callback check-network;
    in property <bool> network-busy;
    in property <string> network-report;
    callback toggle-extra(int);
    callback open-source;
    callback authorize-account;
    callback refresh-account;
    callback disconnect-account;
    callback account-result(int, int, string, string, string);
    callback cancel-sign-in;
    callback open-activation;
    callback check-updates;
    callback install-update;

    changed notice => { root.notice-hidden = false; }

    content-focus := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Back && root.menu-open) {
                root.menu-open = false;
                return accept;
            }
            if (event.text == Key.Back && root.auxiliary) {
                root.back();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        spacing: 0px;

        // top bar
        if !root.auxiliary: HorizontalLayout {
            height: 50px;
            padding-left: 16px;
            padding-right: 8px;
            spacing: 4px;
            Logo { horizontal-stretch: 1; }
            IconButton {
                y: (parent.height - self.height) / 2;
                glyph: Glyph.search;
                description: UiText.tr("Search");
                pressed => { root.search-editing = true; root.navigate(Screen.search); }
            }
            if root.screen == Screen.you: IconButton {
                y: (parent.height - self.height) / 2;
                glyph: Glyph.gear;
                description: UiText.tr("Settings");
                pressed => { content-focus.focus(); root.navigate(Screen.settings); }
            }
        }

        if root.auxiliary && root.screen != Screen.search: HorizontalLayout {
            height: 52px;
            padding-left: 4px;
            padding-right: 8px;
            spacing: 6px;
            IconButton {
                y: (parent.height - self.height) / 2;
                glyph: Glyph.back;
                description: UiText.tr("Back");
                pressed => { content-focus.focus(); root.back(); }
            }
            Text {
                horizontal-stretch: 1;
                text: root.screen == Screen.settings ? UiText.tr("Settings")
                    : root.screen == Screen.channel ? root.channel-name
                    : root.screen == Screen.playlist ? UiText.tr("Playlist")
                    : root.screen == Screen.language ? UiText.tr("App language")
                    : root.screen == Screen.library ? (root.history-mode ? UiText.tr("History") : UiText.tr("Watch later"))
                    : "Stream Tube";
                color: Theme.text;
                font-size: 19px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            if root.screen == Screen.channel || root.screen == Screen.playlist: IconButton {
                y: (parent.height - self.height) / 2;
                glyph: Glyph.search;
                description: UiText.tr("Search");
                pressed => { root.search-editing = true; root.navigate(Screen.search); }
            }
        }

        // search bar
        if root.screen == Screen.search: HorizontalLayout {
            height: 56px;
            padding-left: 4px;
            padding-right: 8px;
            spacing: 4px;
            IconButton {
                y: (parent.height - self.height) / 2;
                glyph: Glyph.back;
                description: UiText.tr("Back");
                pressed => { content-focus.focus(); root.back(); }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 40px;
                y: (parent.height - self.height) / 2;
                border-radius: 20px;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 2px;
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.search-query == "": Text {
                            x: 10px;
                            text: UiText.tr("Search YouTube");
                            color: Theme.secondary;
                            font-size: 16px;
                            vertical-alignment: center;
                        }
                        query := TextInput {
                            x: 10px;
                            width: parent.width - 14px;
                            text <=> root.search-query;
                            color: Theme.text;
                            font-size: 16px;
                            single-line: true;
                            vertical-alignment: center;
                            selection-background-color: #3ea6ff80;
                            input-type: text;
                            init => { if root.search-editing { self.focus(); } }
                            edited => { root.search-editing = true; root.query-changed(self.text); }
                            accepted => {
                                content-focus.focus();
                                root.search-editing = false;
                                root.submit(self.text);
                            }
                        }
                        TouchArea {
                            enabled: !root.search-editing;
                            clicked => { root.search-editing = true; root.query-changed(root.search-query); query.focus(); }
                        }
                    }
                    if root.search-query != "": IconButton {
                        width: 36px;
                        height: 36px;
                        y: 2px;
                        glyph: Glyph.close;
                        icon-size: 18px;
                        description: UiText.tr("Clear");
                        pressed => {
                            root.search-query = "";
                            root.search-editing = true;
                            root.query-changed("");
                            query.focus();
                        }
                    }
                }
            }
        }

        // Home tabs; Subs opens the subscriptions feed, as on YouTube
        if root.screen == Screen.home || root.screen == Screen.following: Flickable {
            height: 48px;
            viewport-width: tabs.preferred-width;
            tabs := HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 2px;
                padding-bottom: 10px;
                spacing: 2px;
                Tab {
                    label: UiText.tr("Home");
                    selected: root.screen == Screen.home && root.category == 0;
                    pressed => { root.pick-category(0); }
                }
                Tab {
                    label: UiText.tr("Subs");
                    selected: root.screen == Screen.following;
                    pressed => {
                        content-focus.focus();
                        root.navigate(Screen.following);
                    }
                }
                Tab {
                    label: UiText.tr("Music");
                    selected: root.screen == Screen.home && root.category == 1;
                    pressed => { root.pick-category(1); }
                }
                Tab {
                    label: UiText.tr("Live");
                    selected: root.screen == Screen.home && root.category == 4;
                    pressed => { root.pick-category(4); }
                }
                Tab {
                    label: UiText.tr("Gaming");
                    selected: root.screen == Screen.home && root.category == 2;
                    pressed => { root.pick-category(2); }
                }
                Tab {
                    label: UiText.tr("News");
                    selected: root.screen == Screen.home && root.category == 3;
                    pressed => { root.pick-category(3); }
                }
            }
        }

        // subscriptions: channel avatars and the Videos / Channels switch
        if root.screen == Screen.following && root.channels.length > 0 && !root.channels-mode: Flickable {
            height: 96px;
            viewport-width: avatars.preferred-width;
            avatars := HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                spacing: 4px;
                for channel in root.channels: Rectangle {
                    width: 72px;
                    height: 84px;
                    VerticalLayout {
                        spacing: 6px;
                        alignment: start;
                        HorizontalLayout {
                            alignment: center;
                            Avatar {
                                width: 56px;
                                source: channel.avatar;
                                has-image: channel.has-avatar;
                                initial: channel.initial;
                            }
                        }
                        Text {
                            text: channel.name;
                            color: Theme.secondary;
                            font-size: 11px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                    TouchArea { clicked => { root.open-channel(channel.id, channel.name); } }
                }
            }
        }
        if root.screen == Screen.following: HorizontalLayout {
            height: 48px;
            padding-left: 12px;
            padding-top: 4px;
            padding-bottom: 12px;
            spacing: 8px;
            alignment: start;
            Chip {
                label: UiText.tr("Videos");
                selected: !root.channels-mode;
                pressed => { root.channels-mode = false; root.reload(); }
            }
            Chip {
                label: UiText.tr("Channels");
                selected: root.channels-mode;
                pressed => { root.channels-mode = true; root.reload(); }
            }
        }
        if root.screen == Screen.following && !root.account-connected && root.account-code == "": VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 4px;
            padding-bottom: 14px;
            spacing: 10px;
            Text {
                text: UiText.tr("Don't miss new videos");
                color: Theme.text;
                font-size: 17px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: UiText.tr("Sign in to see updates from the channels you follow on YouTube");
                color: Theme.secondary;
                font-size: 13px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Pill {
                    label: root.account-busy ? UiText.tr("Waiting for sign-in…") : UiText.tr("Sign in");
                    primary: true;
                    active: !root.account-busy;
                    pressed => { root.authorize-account(); }
                }
            }
        }
        if root.screen == Screen.following && root.account-code != "": HorizontalLayout {
            padding: 12px;
            SignInCode {
                code: root.account-code;
                open => { root.open-activation(); }
                cancel => { root.cancel-sign-in(); }
            }
        }
        if root.screen == Screen.following && root.account-message != "": Text {
            text: UiText.tr(root.account-message);
            color: Theme.accent;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        // channel header
        if root.screen == Screen.channel: HorizontalLayout {
            padding: 16px;
            padding-top: 6px;
            spacing: 16px;
            height: 104px;
            Avatar {
                width: 72px;
                y: 0;
                source: root.channel-avatar;
                has-image: root.channel-has-avatar;
                initial: root.channel-initial;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 10px;
                Text {
                    text: root.channel-name;
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 700;
                    overflow: elide;
                }
                HorizontalLayout {
                    alignment: start;
                    Pill {
                        label: root.channel-remote || root.channel-followed ? UiText.tr("Subscribed") : UiText.tr("Subscribe");
                        primary: !(root.channel-remote || root.channel-followed);
                        active: !root.channel-remote;
                        pressed => { root.follow(); }
                    }
                }
            }
        }

        // search suggestions and recent searches
        if root.screen == Screen.search && root.search-editing: ListView {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: true;
            for entry in (root.search-query == "" ? root.recent-searches : root.suggestions): Rectangle {
                height: 52px;
                background: suggestion-touch.pressed ? Theme.surface : transparent;
                animate background { duration: 120ms; easing: ease-out; }
                suggestion-touch := TouchArea {
                    clicked => {
                        root.search-query = entry;
                        root.search-editing = false;
                        content-focus.focus();
                        root.submit(entry);
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 4px;
                    spacing: 18px;
                    Symbol {
                        width: 22px;
                        height: 22px;
                        y: (parent.height - self.height) / 2;
                        glyph: root.search-query == "" ? Glyph.clock : Glyph.search;
                        tint: Theme.text;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: entry;
                        color: Theme.text;
                        font-size: 15px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        glyph: Glyph.fill;
                        icon-size: 20px;
                        description: UiText.tr("Edit search");
                        pressed => { root.search-query = entry + " "; root.query-changed(entry + " "); }
                    }
                }
            }
        }

        if root.screen == Screen.settings: ScrollView {
            vertical-stretch: 1;
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 200ms; easing: ease-out; }
            mouse-drag-pan-enabled: true;
            viewport-height: preferences.preferred-height;
            preferences := VerticalLayout {
                padding-bottom: 24px;
                spacing: 0px;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 14px;
                    height: 80px;
                    Avatar {
                        width: 48px;
                        y: 0;
                        source: root.account-photo;
                        has-image: root.account-connected && root.account-has-photo;
                        initial: root.account-connected ? root.account-initial : "?";
                        background: root.account-connected ? #00897b : Theme.surface;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.account-connected ? root.account-name : UiText.tr("YouTube account");
                            color: Theme.text;
                            font-size: 17px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: root.account-connected ? UiText.tr("Signed in") : UiText.tr("Not signed in");
                            color: Theme.secondary;
                            font-size: 12px;
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    alignment: start;
                    Pill {
                        label: root.account-busy ? UiText.tr("Waiting for sign-in…")
                            : root.account-connected ? UiText.tr("Switch account") : UiText.tr("Sign in");
                        primary: !root.account-connected;
                        active: !root.account-busy;
                        pressed => { root.authorize-account(); }
                    }
                    if root.account-connected: Pill {
                        label: UiText.tr("Refresh");
                        active: !root.account-busy;
                        pressed => { root.refresh-account(); }
                    }
                    if root.account-connected: Pill {
                        label: UiText.tr("Disconnect");
                        pressed => { root.disconnect-account(); }
                    }
                }
                if root.account-code != "": HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 10px;
                    SignInCode {
                        code: root.account-code;
                        open => { root.open-activation(); }
                        cancel => { root.cancel-sign-in(); }
                    }
                }
                if root.account-message != "": Text {
                    text: UiText.tr(root.account-message);
                    wrap: word-wrap;
                    color: Theme.accent;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
                Rectangle { height: 1px; background: Theme.divider; }
                SectionTitle { text: UiText.tr("General"); }
                SettingRow {
                    label: UiText.tr("App language");
                    detail: root.language-label == "System" ? UiText.tr("System") : root.language-label;
                    chevron: true;
                    pressed => { root.navigate(Screen.language); }
                }
                SettingRow {
                    label: UiText.tr("Thumbnails");
                    toggle: true;
                    checked: root.thumbnails;
                    pressed => { root.toggle-thumbnails(); }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                SectionTitle { text: UiText.tr("SponsorBlock & DeArrow"); }
                SettingRow {
                    label: UiText.tr("Enable SponsorBlock");
                    detail: UiText.tr("Skip sponsors, self-promotion and reminders");
                    toggle: true;
                    checked: root.sponsorblock;
                    pressed => { root.toggle-extra(0); }
                }
                SettingRow {
                    label: UiText.tr("DeArrow titles");
                    toggle: true;
                    checked: root.dearrow-titles;
                    pressed => { root.toggle-extra(1); }
                }
                SettingRow {
                    label: UiText.tr("DeArrow thumbnails");
                    toggle: true;
                    checked: root.dearrow-thumbnails;
                    pressed => { root.toggle-extra(2); }
                }
                SettingRow {
                    label: UiText.tr("Return YouTube Dislike");
                    toggle: true;
                    checked: root.dislike-count;
                    pressed => { root.toggle-extra(3); }
                }
                Rectangle { height: 1px; background: Theme.divider; }
                SectionTitle { text: UiText.tr("About"); }
                SettingRow {
                    label: root.update-state == 1 ? UiText.tr("Checking for updates…")
                        : root.update-state == 3 ? UiText.tr("Update to") + " " + root.update-name
                        : root.update-state == 4 ? UiText.tr("Downloading update…") + " \{root.update-progress}%"
                        : root.update-state == 5 ? UiText.tr("Confirm the installation")
                        : root.update-state == 6 && root.update-name != "" ? UiText.tr("Try the update again")
                        : UiText.tr("Check for updates");
                    detail: root.update-state == 2 ? UiText.tr("Stream Tube is up to date")
                        : root.update-state == 6 ? UiText.tr("Update failed") + ": " + root.update-error
                        : "Stream Tube " + root.app-version;
                    pressed => {
                        if root.update-state == 3 || (root.update-state == 6 && root.update-name != "") {
                            root.install-update();
                        } else if root.update-state != 1 && root.update-state != 4 && root.update-state != 5 {
                            root.check-updates();
                        }
                    }
                }
                SettingRow {
                    label: root.network-busy ? UiText.tr("Checking the network…") : UiText.tr("Network check");
                    detail: UiText.tr("Test thumbnails and video loading on this phone");
                    pressed => { if !root.network-busy { root.check-network(); } }
                }
                if root.network-report != "": Rectangle {
                    height: report-text.preferred-height + 16px;
                    report-text := Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: root.network-report;
                        color: Theme.secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                SettingRow {
                    label: UiText.tr("Source code");
                    chevron: true;
                    pressed => { root.open-source(); }
                }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 12px;
                    AboutSlint { height: 86px; }
                }
            }
        }

        if root.screen == Screen.language: ListView {
            vertical-stretch: 1;
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 200ms; easing: ease-out; }
            mouse-drag-pan-enabled: true;
            for locale[index] in root.languages: LanguageItem {
                entry: locale;
                selected: index == root.language-choice;
                pressed => { root.choose-language(index); }
            }
        }

        // the You tab
        if root.screen == Screen.you: ScrollView {
            vertical-stretch: 1;
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 200ms; easing: ease-out; }
            mouse-drag-pan-enabled: true;
            viewport-height: you.preferred-height;
            you := VerticalLayout {
                padding-bottom: 24px;
                HorizontalLayout {
                    padding: 16px;
                    spacing: 16px;
                    height: 104px;
                    Avatar {
                        width: 72px;
                        y: 0;
                        source: root.account-photo;
                        has-image: root.account-connected && root.account-has-photo;
                        initial: root.account-connected ? root.account-initial : "";
                        background: root.account-connected ? #00897b : Theme.surface;
                        if !root.account-connected: Symbol {
                            width: 36px;
                            height: 36px;
                            glyph: Glyph.you;
                            tint: Theme.secondary;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: root.account-connected ? root.account-name : UiText.tr("Enjoy your favorite videos");
                            color: Theme.text;
                            font-size: 20px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Pill {
                                label: root.account-connected ? UiText.tr("Settings") : root.account-busy ? UiText.tr("Waiting for sign-in…") : UiText.tr("Sign in");
                                primary: !root.account-connected;
                                active: root.account-connected || !root.account-busy;
                                pressed => {
                                    if root.account-connected {
                                        root.navigate(Screen.settings);
                                    } else {
                                        root.authorize-account();
                                    }
                                }
                            }
                        }
                    }
                }
                if root.account-code != "": HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 8px;
                    SignInCode {
                        code: root.account-code;
                        open => { root.open-activation(); }
                        cancel => { root.cancel-sign-in(); }
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    SectionTitle { horizontal-stretch: 1; padding-left: 0px; text: UiText.tr("History"); }
                    Pill {
                        y: 4px;
                        label: UiText.tr("View all");
                        pressed => { root.history-mode = true; root.navigate(Screen.library); }
                    }
                }
                if root.history-preview.length == 0: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    height: 36px;
                    Text {
                        text: UiText.tr("Videos you watch will show up here");
                        color: Theme.secondary;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.history-preview.length > 0: Flickable {
                    height: 158px;
                    viewport-width: history-row.preferred-width;
                    history-row := HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;
                        for item in root.history-preview: MiniCard {
                            video: item;
                            watch => { root.watch-preview(true, item.id); }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    SectionTitle { horizontal-stretch: 1; padding-left: 0px; text: UiText.tr("Watch later"); }
                    Pill {
                        y: 4px;
                        label: UiText.tr("View all");
                        pressed => { root.history-mode = false; root.navigate(Screen.library); }
                    }
                }
                if root.saved-preview.length == 0: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    height: 36px;
                    Text {
                        text: UiText.tr("Save videos from the More menu to watch them later");
                        color: Theme.secondary;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                if root.saved-preview.length > 0: Flickable {
                    height: 158px;
                    viewport-width: saved-row.preferred-width;
                    saved-row := HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;
                        for item in root.saved-preview: MiniCard {
                            video: item;
                            watch => { root.watch-preview(false, item.id); }
                        }
                    }
                }
                Rectangle { height: 8px; }
                Rectangle { height: 1px; background: Theme.divider; }
                SettingRow {
                    label: UiText.tr("Settings");
                    chevron: true;
                    pressed => { root.navigate(Screen.settings); }
                }
                SettingRow {
                    label: UiText.tr("Check for updates");
                    detail: "Stream Tube " + root.app-version;
                    pressed => { root.check-updates(); root.navigate(Screen.settings); }
                }
            }
        }

        if root.showing-channels && root.channels.length > 0: ListView {
            vertical-stretch: 1;
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 200ms; easing: ease-out; }
            mouse-drag-pan-enabled: true;
            for channel in root.channels: Rectangle {
                height: 64px;
                background: channel-touch.pressed ? Theme.surface : transparent;
                animate background { duration: 120ms; easing: ease-out; }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 16px;
                    Avatar {
                        width: 40px;
                        y: (parent.height - self.height) / 2;
                        source: channel.avatar;
                        has-image: channel.has-avatar;
                        initial: channel.initial;
                    }
                    Text {
                        text: channel.name;
                        color: Theme.text;
                        font-size: 15px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                channel-touch := TouchArea { clicked => { root.open-channel(channel.id, channel.name); } }
            }
        }

        // loading skeleton, empty and error states
        if root.feed-screen && root.videos.length == 0 && root.busy
            && (!root.showing-channels || root.channels.length == 0): Rectangle {
            vertical-stretch: 1;
            clip: true;
            skeleton := SkeletonCard {
                x: (parent.width - self.width) / 2;
                y: 0px;
                width: min(parent.width, 640px);
            }
            SkeletonCard {
                x: skeleton.x;
                y: skeleton.height + 16px;
                width: skeleton.width;
            }
            SkeletonCard {
                x: skeleton.x;
                y: (skeleton.height + 16px) * 2;
                width: skeleton.width;
            }
        }
        if root.feed-screen && root.videos.length == 0 && !root.busy
            && (!root.showing-channels || root.channels.length == 0): VerticalLayout {
            vertical-stretch: 1;
            padding: 32px;
            spacing: 14px;
            alignment: start;
            Text {
                text: UiText.tr(root.message);
                color: Theme.secondary;
                font-size: 14px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            if root.failed: HorizontalLayout {
                alignment: center;
                Pill {
                    label: UiText.tr("Retry");
                    pressed => { root.reload(); }
                }
            }
        }

        if root.screen == Screen.shorts: Rectangle {
            vertical-stretch: 1;
            if root.videos.length > 0: Pill {
                width: 220px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                label: UiText.tr("Watch Shorts");
                primary: true;
                pressed => { root.open-shorts(); }
            }
            if root.videos.length == 0 && root.busy: Spinner {
                width: 36px;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                indeterminate: true;
            }
            if root.videos.length == 0 && !root.busy: Text {
                x: 24px;
                width: parent.width - 48px;
                y: (parent.height - self.height) / 2;
                text: UiText.tr(root.message);
                color: Theme.secondary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        if root.feed-screen && !root.showing-channels && root.videos.length > 0: list := ListView {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: true;
            viewport-y <=> root.feed-scroll;
            opacity: root.busy ? 0.35 : 1;
            animate opacity { duration: 220ms; easing: ease-out; }
            scrolled => {
                if root.has-more && !root.loading-more && !root.load-more-failed
                    && list.viewport-height + list.viewport-y < list.visible-height * 1.7 {
                    root.load-more();
                }
            }
            for video in root.videos: Rectangle {
                width: list.visible-width;
                height: video.kind == 1 ? ShortsMetrics.shelf-height(root.card-width) + 16px : card.height + 16px;
                if video.kind == 1: ShortsShelf {
                    y: 0;
                    width: root.card-width;
                    x: (parent.width - self.width) / 2;
                    shorts: root.shorts-shelf;
                    watch(id) => { root.watch-short(id); }
                }
                card := VideoCard {
                    y: 0;
                    visible: video.kind == 0;
                    width: root.card-width;
                    x: (parent.width - self.width) / 2;
                    video: video;
                    watch => { root.watch(video.id); }
                    save => { root.save(video.id); }
                    menu => { root.menu-video = video; root.menu-open = true; }
                    open-channel => { root.open-channel(video.channel-id, video.channel); }
                }
            }
        }

        if root.feed-screen && root.has-more && (root.loading-more || root.load-more-failed): HorizontalLayout {
            height: 52px;
            alignment: center;
            if root.loading-more: Spinner {
                width: 28px;
                height: 28px;
                y: 12px;
                indeterminate: true;
            }
            if root.load-more-failed: Pill {
                y: 8px;
                label: UiText.tr("Retry loading more");
                pressed => { root.load-more(); }
            }
        }

        if (root.update-state == 3 && !root.update-dismissed) || root.update-state == 4 || root.update-state == 5: Rectangle {
            height: 56px;
            background: Theme.raised;
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 240ms; easing: ease-out; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: root.update-state == 3 ? UiText.tr("Update available") + ": " + root.update-name
                        : root.update-state == 4 ? UiText.tr("Downloading update…") + " \{root.update-progress}%"
                        : UiText.tr("Confirm the installation");
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.update-state == 3: Pill {
                    y: 10px;
                    label: UiText.tr("Update");
                    primary: true;
                    pressed => { root.install-update(); }
                }
                if root.update-state == 3: IconButton {
                    y: 8px;
                    glyph: Glyph.close;
                    icon-size: 18px;
                    description: UiText.tr("Later");
                    pressed => { root.update-dismissed = true; }
                }
            }
        }

        HorizontalLayout {
            height: 56px;
            NavigationItem {
                glyph: Glyph.home;
                label: UiText.tr("Home");
                selected: root.tab == Screen.home && !root.auxiliary;
                pressed => {
                    content-focus.focus();
                    // as on YouTube: a scrolled Home goes back to the top, a Home at the top refreshes
                    if root.screen == Screen.home && root.feed-scroll < -1px {
                        root.feed-scroll = 0;
                    } else {
                        root.navigate(Screen.home);
                    }
                }
            }
            NavigationItem {
                glyph: Glyph.shorts;
                label: UiText.tr("Shorts");
                selected: root.tab == Screen.shorts && !root.auxiliary;
                pressed => { content-focus.focus(); root.navigate(Screen.shorts); }
            }
            NavigationItem {
                glyph: Glyph.following;
                label: UiText.tr("Subscriptions");
                selected: root.tab == Screen.following && !root.auxiliary;
                pressed => {
                    content-focus.focus();
                    if root.screen == Screen.following {
                        root.feed-scroll = 0;
                    }
                    root.navigate(Screen.following);
                }
            }
            NavigationItem {
                glyph: Glyph.you;
                account: root.account-connected;
                photo: root.account-photo;
                has-photo: root.account-has-photo;
                initial: root.account-initial;
                label: UiText.tr("You");
                selected: root.tab == Screen.you && !root.auxiliary;
                pressed => { content-focus.focus(); root.navigate(Screen.you); }
            }
        }
    }

    // snackbar for short notices
    if root.notice != "" && !root.notice-hidden: Rectangle {
        x: 12px;
        width: root.width - 24px;
        y: root.height - root.safe-area-insets.bottom - 57px - self.height - 12px;
        height: 48px;
        border-radius: 8px;
        background: #323232;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000080;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 200ms; easing: ease-out; }
        Text {
            x: 16px;
            width: parent.width - 32px;
            text: UiText.tr(root.notice);
            color: #ffffff;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
        TouchArea { clicked => { root.notice-hidden = true; } }
        Timer {
            interval: 3500ms;
            running: true;
            triggered => { root.notice-hidden = true; }
        }
    }

    // ⋮ action sheet
    if root.menu-open: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000099;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 180ms; easing: ease-out; }
        TouchArea { clicked => { root.menu-open = false; } }
        sheet := Rectangle {
            x: (parent.width - self.width) / 2;
            width: min(parent.width, 560px);
            height: sheet-items.preferred-height + root.safe-area-insets.bottom;
            y: parent.height;
            init => { self.y = parent.height - self.height; }
            animate y { duration: 240ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
            border-top-left-radius: 14px;
            border-top-right-radius: 14px;
            background: Theme.raised;
            TouchArea { }
            sheet-items := VerticalLayout {
                padding-top: 8px;
                padding-bottom: 12px;
                alignment: start;
                HorizontalLayout {
                    alignment: center;
                    height: 16px;
                    Rectangle {
                        width: 40px;
                        height: 4px;
                        y: 4px;
                        border-radius: 2px;
                        background: #717171;
                    }
                }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    height: 40px;
                    Text {
                        text: root.menu-video.title;
                        color: Theme.secondary;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                SheetRow {
                    glyph: Glyph.bookmark;
                    filled: root.menu-video.saved;
                    label: root.menu-video.saved ? UiText.tr("Remove from Watch later") : UiText.tr("Save to Watch later");
                    pressed => { root.save(root.menu-video.id); root.menu-open = false; }
                }
                if root.menu-video.channel-id != "": SheetRow {
                    glyph: Glyph.channel;
                    label: UiText.tr("Go to channel");
                    pressed => {
                        root.menu-open = false;
                        root.open-channel(root.menu-video.channel-id, root.menu-video.channel);
                    }
                }
                SheetRow {
                    glyph: Glyph.block;
                    label: UiText.tr("Not interested");
                    pressed => { root.hide-video(root.menu-video.id); root.menu-open = false; }
                }
            }
        }
    }
}
