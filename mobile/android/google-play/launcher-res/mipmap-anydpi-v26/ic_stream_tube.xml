<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: the launcher masks the background into its own shape
     and the glyph stays inside the 66dp safe zone, so nothing is cropped. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_stream_tube_background" />
    <foreground android:drawable="@drawable/ic_stream_tube_foreground" />
    <monochrome android:drawable="@drawable/ic_stream_tube_foreground" />
</adaptive-icon>
